# Copy to .env and fill locally. Never commit .env or real values.
# Customer tests skip while the variables they need are empty.

BASE_URL=
CUSTOMER_BASE_URL=

# Full menu URL from the table QR, one per table preference.
# 1 QSR prepaid, 2 Dine-in, 3 View and pay bill, 4 Takeaway.
QR_QSR=
QR_DINEIN=
QR_PAYBILL=
QR_TAKEAWAY=
QR_EXPIRED=

# Dine-in "Place your order" sheet.
CUSTOMER_NAME=
CUSTOMER_MOBILE=

# Names as shown on the customer menu. Leave empty until confirmed for the outlet.
MENU_CATEGORY=
MENU_SIMPLE_ITEM=
MENU_SECOND_ITEM=
MENU_OOS_ITEM=

# Telr sandbox card for a successful pay. Do not commit a real card.
CARD_NUMBER=
CARD_EXPIRY=
CARD_CVV=

# Optional sandbox cards that force a non-success result. Unverified; tests skip while empty.
CARD_NUMBER_FAILURE=
CARD_NUMBER_TIMEOUT=
